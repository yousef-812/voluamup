<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Contact / Caller Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/ivInCallAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Contact Name -->
        <TextView
            android:id="@+id/tvInCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Phone Number of Called/Caller -->
        <TextView
            android:id="@+id/tvInCallNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/boost_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Call Status / Timer -->
        <TextView
            android:id="@+id/tvInCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- DTMF Touch-Tone Keypad (Collapsible) -->
        <LinearLayout
            android:id="@+id/layoutDtmfKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:columnCount="3"
                android:rowCount="4">

                <Button
                    android:id="@+id/btnDtmf1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="2"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="4"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="5"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf6"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="6"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf7"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="7"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf8"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="8"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf9"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="9"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmfStar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="*"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmf0"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btnDtmfHash"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="#"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />

            </GridLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Incoming Call Action Buttons (Answer / Reject) -->
        <LinearLayout
            android:id="@+id/layoutIncomingCallActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:visibility="gone">

            <!-- Reject Call FAB -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnRejectCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/call_red"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/text_primary" />

            <!-- Answer Call FAB -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnAnswerCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_allow"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/call_green"
                app:icon="@android:drawable/ic_menu_call"
                app:iconTint="@color/text_primary" />
        </LinearLayout>

        <!-- Active Call Control Grid -->
        <LinearLayout
            android:id="@+id/layoutActiveCallContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="3">

                <!-- Earpiece Boost 200% Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleBooster"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/earpiece_booster_btn"
                    android:textColor="@color/boost_gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_lock_silent_mode_off"
                    app:iconTint="@color/boost_gold"
                    app:strokeColor="@color/boost_gold"
                    app:strokeWidth="1.5dp" />

                <!-- Route Speaker Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleSpeaker"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/route_speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/stat_sys_speakerphone"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/surface_dark" />

                <!-- Mute / Unmute Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMute"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/mute"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_btn_speak_now"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/surface_dark" />

                <!-- Toggle Keypad Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleKeypad"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/btn_keypad"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_dialog_dialer"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/surface_dark" />

                <!-- Add Call Button (Centered Full-Width Grid Row) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCall"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="2"
                    android:layout_margin="6dp"
                    android:text="@string/btn_add_call"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/surface_dark" />

            </GridLayout>

            <!-- End Call Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEndCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/end_call"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/text_primary"
                app:backgroundTint="@color/call_red"
                app:fabSize="normal" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
